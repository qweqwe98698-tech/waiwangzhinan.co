---

<div class="card-surface p-6 sm:p-8" id="device-picker">
  <div class="mb-6">
    <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-mint mb-1">
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
        <line x1="8" y1="21" x2="16" y2="21"></line>
        <line x1="12" y1="17" x2="12" y2="21"></line>
      </svg>
      <span>Device Picker</span>
    </div>
    <h3 class="text-2xl font-bold text-content-primary">你正在使用什么设备？</h3>
    <p class="text-xs text-content-secondary mt-1">先选设备，系统会直接告诉你该装什么客户端、怎么导入与配置。</p>
  </div>

  <!-- Device Selection Tabs -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-2 mb-6">
    {deviceData.map((d, index) => (
      <button
        type="button"
        class={`device-tab-btn px-4 py-3 rounded-lg border text-left flex flex-col justify-between transition-all ${
          index === 0
            ? 'bg-bg-sub border-brand-mint/40 text-brand-mint'
            : 'bg-bg-main border-white/5 text-content-secondary hover:border-white/20 hover:text-content-primary'
        }`}
        data-device={d.id}
      >
        <span class="font-bold text-sm text-content-primary">{d.name}</span>
        <span class="text-[10px] text-content-muted mt-1">{d.badge}</span>
      </button>
    ))}
  </div>

  <!-- Device Content Panels -->
  {deviceData.map((d, index) => (
    <div
      id={`device-panel-${d.id}`}
      class={`device-panel space-y-5 ${index === 0 ? 'block' : 'hidden'}`}
    >
      <!-- Recommended Clients -->
      <div>
        <h4 class="text-xs font-semibold text-content-muted uppercase tracking-wider mb-2.5">
          {d.name} 推荐客户端
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {d.clients.map((c) => (
            <a
              href={c.url}
              class="flex items-center justify-between p-3.5 rounded-lg bg-bg-sub border border-white/5 hover:border-brand-mint/30 transition-all group"
            >
              <div>
                <span class="font-semibold text-sm text-content-primary group-hover:text-brand-mint transition-colors">
                  {c.name}
                </span>
                <span class="block text-[11px] text-brand-mint/80 mt-0.5">{c.tag}</span>
              </div>
              <svg class="w-4 h-4 text-content-muted group-hover:text-brand-mint transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Tutorials List -->
      <div>
        <h4 class="text-xs font-semibold text-content-muted uppercase tracking-wider mb-2.5">
          {d.name} 新手推荐阅读与排错
        </h4>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {d.tutorials.map((t) => (
            <a
              href={t.url}
              class="p-2.5 rounded-lg bg-bg-main hover:bg-bg-sub border border-white/5 hover:border-white/15 text-xs text-content-secondary hover:text-content-primary flex items-center justify-between transition-colors group"
            >
              <span class="truncate pr-2">{t.title}</span>
              <span class="text-brand-mint text-[11px] opacity-0 group-hover:opacity-100 transition-opacity">阅读 →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  const tabBtns = document.querySelectorAll('.device-tab-btn');
  const panels = document.querySelectorAll('.device-panel');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetDevice = btn.getAttribute('data-device');

      // Update Tabs styling
      tabBtns.forEach((b) => {
        b.classList.remove('bg-bg-sub', 'border-brand-mint/40', 'text-brand-mint');
        b.classList.add('bg-bg-main', 'border-white/5', 'text-content-secondary');
      });
      btn.classList.add('bg-bg-sub', 'border-brand-mint/40', 'text-brand-mint');
      btn.classList.remove('bg-bg-main', 'border-white/5', 'text-content-secondary');

      // Update Panels
      panels.forEach((p) => {
        p.classList.add('hidden');
      });
      const activePanel = document.getElementById(`device-panel-${targetDevice}`);
      if (activePanel) {
        activePanel.classList.remove('hidden');
      }
    });
  });
</script>
