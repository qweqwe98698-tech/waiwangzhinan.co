---

<div class="card-surface p-6 sm:p-8 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div>
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-mint mb-1">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span>Scenario Navigator</span>
      </div>
      <h3 class="text-2xl font-bold text-content-primary">你想访问什么服务？</h3>
    </div>
    <p class="text-xs text-content-secondary">涵盖 8 大主流场景，一键直达专属网络配置与环境要求</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
    {scenarioCategories.map((cat) => (
      <div class="card-surface-sub p-4 rounded-xl border border-white/5 flex flex-col justify-between space-y-3">
        <div>
          <div class="flex items-center justify-between pb-2 border-b border-white/5 mb-3">
            <h4 class="font-bold text-sm text-content-primary">{cat.category}</h4>
            <span class="text-[10px] text-content-muted font-mono bg-white/5 px-2 py-0.5 rounded">{cat.tag}</span>
          </div>
          <div class="space-y-2">
            {cat.items.map((item) => (
              <a
                href={item.url}
                class="p-2 rounded-lg bg-bg-main hover:bg-bg-hover border border-white/[0.03] hover:border-brand-mint/30 flex items-center justify-between group transition-all"
              >
                <div>
                  <span class="font-medium text-xs text-content-primary group-hover:text-brand-mint transition-colors block">
                    {item.name}
                  </span>
                  <span class="text-[10px] text-content-muted block">{item.note}</span>
                </div>
                <span class="text-brand-mint text-xs opacity-0 group-hover:opacity-100 transition-opacity">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
