---
export interface NextStepItem {
  title: string;
  url: string;
  description?: string;
}

export interface Props {
  completedConcept?: string;
  steps: NextStepItem[];
}

const { completedConcept, steps = [] } = Astro.props;
---

<div class="my-10 rounded-xl bg-bg-card border border-white/10 p-6 sm:p-8 space-y-5">
  <!-- Progress Header -->
  <div class="flex items-center justify-between gap-4 pb-4 border-b border-white/5">
    <div class="flex items-center gap-2.5">
      <div class="w-7 h-7 rounded-full bg-brand-mint/10 border border-brand-mint/30 flex items-center justify-center text-brand-mint">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <div>
        <span class="text-xs font-semibold text-brand-mint uppercase tracking-wider block">知识进度已达成</span>
        <h4 class="text-sm font-bold text-content-primary">
          {completedConcept ? `✓ 你已掌握：${completedConcept}` : '✓ 本篇核心知识点已通读'}
        </h4>
      </div>
    </div>
    <span class="text-xs font-mono text-content-muted">Next Step</span>
  </div>

  <!-- Recommendation Steps -->
  <div>
    <h5 class="text-xs font-semibold text-content-muted uppercase tracking-wider mb-3">
      推荐接下来按顺序阅读：
    </h5>
    <div class="space-y-2.5">
      {steps.map((step, idx) => (
        <a
          href={step.url}
          class="flex items-center justify-between p-3 rounded-lg bg-bg-sub hover:bg-bg-hover border border-white/5 hover:border-brand-mint/30 transition-all group"
        >
          <div class="flex items-center gap-3">
            <span class="w-5 h-5 rounded bg-white/5 text-[11px] font-mono font-bold text-content-muted group-hover:text-brand-mint flex items-center justify-center transition-colors">
              {idx + 1}
            </span>
            <div>
              <span class="font-medium text-sm text-content-primary group-hover:text-brand-mint transition-colors">
                {step.title}
              </span>
              {step.description && (
                <span class="block text-xs text-content-muted mt-0.5">{step.description}</span>
              )}
            </div>
          </div>
          <svg class="w-4 h-4 text-content-muted group-hover:text-brand-mint transform group-hover:translate-x-1 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
      ))}
    </div>
  </div>
</div>
