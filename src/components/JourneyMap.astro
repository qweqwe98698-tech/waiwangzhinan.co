---
const steps = [
  {
    step: '01',
    level: 'L0',
    title: '需求产生',
    desc: '想用 ChatGPT、查 Google、看 YouTube，发现打不开',
    tag: '产生意图',
    link: '/start/',
  },
  {
    step: '02',
    level: 'L1',
    title: '了解代理',
    desc: '搞懂 VPN、Proxy、中转与分流的基本概念',
    tag: '基础概念',
    link: '/start/what-is-proxy/',
  },
  {
    step: '03',
    level: 'L2',
    title: '认识机场',
    desc: '明白什么是机场、节点与一键订阅链接',
    tag: '核心认知',
    link: '/airport/what-is-airport/',
  },
  {
    step: '04',
    level: 'L3',
    title: '选择客户端',
    desc: '根据设备安装 Clash Verge、小火箭或 v2rayN',
    tag: '工具准备',
    link: '/clients/',
  },
  {
    step: '05',
    level: 'L3',
    title: '导入订阅',
    desc: '将服务商订阅链接导入客户端并配置规则',
    tag: '配置操作',
    link: '/airport/how-to-use/',
  },
  {
    step: '06',
    level: 'L4-L5',
    title: '稳定使用与排错',
    desc: '学会根据需求选择服务，遇到超时能快速排查',
    tag: '排错选型',
    link: '/fix/',
  },
];
---

<div class="relative py-8">
  <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-brand-mint/10 border border-brand-mint/20 text-xs font-semibold text-brand-mint mb-2">
        <span>Journey Map</span>
        <span class="w-1 h-1 rounded-full bg-brand-mint"></span>
        <span>新手认知地图</span>
      </div>
      <h3 class="text-2xl font-bold text-content-primary tracking-tight">从零到熟练的 6 个关键阶段</h3>
    </div>
    <p class="text-xs text-content-secondary max-w-md">
      不用一口气全弄明白。点击任意阶段，即可直接进入对应的基础指南。
    </p>
  </div>

  <!-- Interactive Steps Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-3.5 relative">
    {steps.map((item, idx) => (
      <a
        href={item.link}
        class="group relative card-surface p-4 flex flex-col justify-between hover:border-brand-mint/40 transition-all duration-200"
      >
        <!-- Step Header -->
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs font-bold text-brand-mint bg-brand-mint/10 px-2 py-0.5 rounded border border-brand-mint/20">
            {item.step}
          </span>
          <span class="text-[10px] text-content-muted font-mono">{item.level}</span>
        </div>

        <!-- Step Content -->
        <div class="space-y-1.5 mb-4">
          <h4 class="font-bold text-sm text-content-primary group-hover:text-brand-mint transition-colors">
            {item.title}
          </h4>
          <p class="text-xs text-content-secondary leading-relaxed">
            {item.desc}
          </p>
        </div>

        <!-- Step Footer Tag & Arrow -->
        <div class="pt-2 border-t border-white/5 flex items-center justify-between text-[11px] text-content-muted group-hover:text-brand-mint transition-colors">
          <span>{item.tag}</span>
          <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>
