---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import PromoToast from '../components/PromoToast.astro';
import PWAInstaller from '../components/PWAInstaller.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  faq?: Array<{ question: string; answer: string }>;
  breadcrumbs?: Array<{ name: string; url: string }>;
  itemList?: Array<{ name: string; url: string; position?: number }>;
  aboutPage?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  author,
  faq,
  breadcrumbs,
  itemList,
  aboutPage,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      faq={faq}
      breadcrumbs={breadcrumbs}
      itemList={itemList}
      aboutPage={aboutPage}
    />
  </head>
  <body class="min-h-screen bg-bg-main text-content-primary flex flex-col antialiased selection:bg-brand-mint/20 selection:text-white">
    <PWAInstaller />
    <Header />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
    <SearchModal />
    <PromoToast />
  </body>
</html>
