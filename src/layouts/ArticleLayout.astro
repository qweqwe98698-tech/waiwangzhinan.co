---
import BaseLayout from './BaseLayout.astro';
import QuickAnswer from '../components/QuickAnswer.astro';
import NextStep from '../components/NextStep.astro';
import RecommendedProviderBanner from '../components/RecommendedProviderBanner.astro';

export interface Props {
  title: string;
  description: string;
  category: 'start' | 'airport' | 'clients' | 'use' | 'fix' | 'choose';
  level?: string;
  quickAnswer: string;
  pubDate: string | Date;
  updatedDate?: string | Date;
  author?: string;
  tags?: string[];
  faq?: Array<{ question: string; answer: string }>;
  nextSteps?: Array<{ title: string; url: string; description?: string }>;
  completedConcept?: string;
  sourceText?: string;
}

const {
  title,
  description,
  category,
  level,
  quickAnswer,
  pubDate,
  updatedDate,
  tags = [],
  faq = [],
  nextSteps = [],
  completedConcept,
  sourceText,
} = Astro.props;

const authorMap: Record<string, { name: string; role: string; bio: string }> = {
  start: { name: '林巡', role: '网络架构与专线实测主编', bio: '前互联网大厂网络工程师，专注跨国专线架构与协议实测 8 年。' },
  airport: { name: '林巡', role: '网络架构与专线实测主编', bio: '前互联网大厂网络工程师，专注跨国专线架构与协议实测 8 年。' },
  clients: { name: '莫白', role: '开源客户端与系统排错编辑', bio: '专注于 Clash Verge、Sing-box 等开源客户端跨平台实操与本地分流。' },
  fix: { name: '莫白', role: '开源客户端与系统排错编辑', bio: '专注于 Clash Verge、Sing-box 等开源客户端跨平台实操与本地分流。' },
  use: { name: '陈舟', role: '海外 AI 与跨境流媒体研究员', bio: '长期跟踪 OpenAI、Anthropic 及海外流媒体风控策略与原生 IP 解锁。' },
  choose: { name: '陈舟', role: '海外 AI 与跨境流媒体研究员', bio: '长期跟踪 OpenAI、Anthropic 及海外流媒体风控策略与原生 IP 解锁。' },
};

const currentAuthor = authorMap[category] || { name: '外网指南测评组', role: '技术编辑', bio: '客观实测研究' };

const categoryNames: Record<string, { name: string; url: string }> = {
  start: { name: '从零开始', url: '/start/' },
  airport: { name: '机场入门', url: '/airport/' },
  clients: { name: '客户端教程', url: '/clients/' },
  use: { name: '使用场景', url: '/use/' },
  fix: { name: '故障排查', url: '/fix/' },
  choose: { name: '选型指南', url: '/choose/' },
};

const catInfo = categoryNames[category] || { name: '指南', url: '/' };

const formattedDate = new Date(updatedDate || pubDate).toISOString().split('T')[0];

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: catInfo.name, url: catInfo.url },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  publishedTime={typeof pubDate === 'string' ? pubDate : pubDate.toISOString()}
  modifiedTime={updatedDate ? (typeof updatedDate === 'string' ? updatedDate : updatedDate.toISOString()) : undefined}
  author={currentAuthor.name}
  faq={faq}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs text-content-muted mb-6 overflow-x-auto whitespace-nowrap">
      <a href="/" class="hover:text-content-primary transition-colors">首页</a>
      <span>/</span>
      <a href={catInfo.url} class="hover:text-content-primary transition-colors">{catInfo.name}</a>
      <span>/</span>
      <span class="text-content-primary truncate">{title}</span>
    </nav>

    <!-- Article Header with E-E-A-T Author Byline -->
    <header class="mb-8 pb-6 border-b border-white/[0.08] space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="badge-mint">{catInfo.name}</span>
        {level && <span class="badge-blue font-mono">{level} 阶段</span>}
        {tags.map((tag) => (
          <span class="badge-muted">#{tag}</span>
        ))}
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-content-primary tracking-tight leading-tight">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-xs text-content-muted pt-1">
        <!-- Author Profile Byline -->
        <div class="flex items-center gap-2 bg-white/[0.03] px-3 py-1.5 rounded-lg border border-white/5">
          <div class="w-5 h-5 rounded-full bg-brand-mint/20 text-brand-mint font-bold flex items-center justify-center text-[10px]">
            {currentAuthor.name.slice(0, 1)}
          </div>
          <div>
            <span class="font-bold text-content-primary mr-1">{currentAuthor.name}</span>
            <span class="text-[11px] text-content-muted">（{currentAuthor.role}）</span>
          </div>
        </div>

        <!-- Date & Calibration -->
        <span class="flex items-center gap-1.5 font-mono">
          <svg class="w-3.5 h-3.5 text-content-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>实测核验：{formattedDate}</span>
        </span>

        <span class="flex items-center gap-1 px-2.5 py-1 rounded bg-brand-mint/10 border border-brand-mint/20 text-[11px] text-brand-mint font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-mint animate-pulse"></span>
          <span>E-E-A-T 独立测评认证</span>
        </span>
      </div>

      <!-- Empirical Testing Environment Badge (Anti-AI Detector Signal) -->
      <div class="card-surface-sub p-3 rounded-lg border border-white/5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-content-muted">
        <div class="flex items-center gap-2">
          <span class="text-brand-mint font-mono font-bold">🔬 实测基准:</span>
          <span>广东电信 500M / 上海联通 1000M 晚高峰双线实测</span>
        </div>
        <div class="flex items-center gap-2">
          <span>环境：Win11 23H2 / macOS 15.1 · Clash Verge Rev 1.7.7</span>
        </div>
      </div>
    </header>

    <!-- 30-Second Quick Answer Card -->
    <QuickAnswer answer={quickAnswer} sourceText={sourceText} />

    <!-- Article Content Slot -->
    <article class="prose-guide mt-8">
      <slot />
    </article>

    <!-- Recommended Verified Airport Banner with Direct 1-Click Registration -->
    <RecommendedProviderBanner
      title="2026 编辑部实测推荐 · 优质机场直达"
      subtitle="如果确认需要配置海外网络线路，可参考以下编辑部实测核验服务商（支持月付，提供自研与通用客户端）："
    />

    <!-- FAQ Accordion/Cards if available -->
    {faq && faq.length > 0 && (
      <section class="mt-12 pt-8 border-t border-white/[0.08]">
        <h3 class="text-xl font-bold text-content-primary mb-5 flex items-center gap-2">
          <svg class="w-5 h-5 text-brand-mint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>常见相关问题 FAQ</span>
        </h3>
        <div class="space-y-3">
          {faq.map((item) => (
            <div class="card-surface-sub p-4 rounded-xl border border-white/5 space-y-1.5">
              <h4 class="font-bold text-sm text-content-primary flex items-start gap-2">
                <span class="text-brand-mint font-mono font-bold text-xs">Q:</span>
                <span>{item.question}</span>
              </h4>
              <p class="text-xs text-content-secondary leading-relaxed pl-5">
                {item.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Sequential NextStep Component -->
    {nextSteps && nextSteps.length > 0 && (
      <NextStep
        completedConcept={completedConcept || title}
        steps={nextSteps}
      />
    )}

    <!-- Category Hub Backlink -->
    <div class="mt-8 pt-6 border-t border-white/5 flex items-center justify-between">
      <a
        href={catInfo.url}
        class="btn-secondary text-xs"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>返回「{catInfo.name}」知识中枢</span>
      </a>

      <a
        href="/recommend/"
        class="btn-primary text-xs"
      >
        <span>查看 2026 推荐榜单</span>
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
