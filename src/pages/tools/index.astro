<script>
  // Tool 1: Inspector logic
  const inspectBtn = document.getElementById('inspect-btn');
  const clearBtn = document.getElementById('clear-input-btn');
  const nodeInput = document.getElementById('node-input') as HTMLTextAreaElement;
  const resultBox = document.getElementById('inspect-result');
  const formatBadge = document.getElementById('format-badge');
  const detailsBox = document.getElementById('inspect-details');

  if (inspectBtn && nodeInput && resultBox && formatBadge && detailsBox) {
    inspectBtn.addEventListener('click', () => {
      const text = nodeInput.value.trim();
      if (!text) {
        alert('请先输入订阅链接或节点代码');
        return;
      }

      resultBox.classList.remove('hidden');

      if (text.startsWith('http://') || text.startsWith('https://')) {
        formatBadge.textContent = '标准 HTTP/HTTPS 订阅链接';
        formatBadge.className = 'badge-mint text-[10px]';
        detailsBox.innerHTML = `
          <div>🔗 <strong>类型</strong>：远程客户端一键订阅 URL</div>
          <div>🛡️ <strong>建议协议</strong>：可在 Clash Verge、小火箭、Surfboard 中直接点击导入</div>
          <div>💡 <strong>安全提醒</strong>：请确认该订阅链接来源正规，切勿在公共群聊分享 Token</div>
        `;
      } else if (text.startsWith('vless://')) {
        formatBadge.textContent = 'VLESS 现代协议节点';
        formatBadge.className = 'badge-mint text-[10px]';
        detailsBox.innerHTML = `
          <div>⚡ <strong>协议内核</strong>：VLESS (轻量无状态架构)</div>
          <div>🛡️ <strong>伪装等级</strong>：极高（支持 Reality 借壳伪装，防封锁能力第一梯队）</div>
          <div>🎯 <strong>适用场景</strong>：ChatGPT 登录、海外 4K 流媒体、全平台秒开</div>
        `;
      } else if (text.startsWith('trojan://')) {
        formatBadge.textContent = 'Trojan TLS 伪装协议';
        formatBadge.className = 'badge-mint text-[10px]';
        detailsBox.innerHTML = `
          <div>⚡ <strong>协议内核</strong>：Trojan (标准 HTTPS 流量伪装)</div>
          <div>🛡️ <strong>伪装等级</strong>：高（真实 TLS 证书握手）</div>
          <div>🎯 <strong>适用场景</strong>：日常 Google 搜索与 YouTube 浏览</div>
        `;
      } else if (text.startsWith('ss://')) {
        formatBadge.textContent = 'Shadowsocks 经典专线协议';
        formatBadge.className = 'badge-blue text-[10px]';
        detailsBox.innerHTML = `
          <div>⚡ <strong>协议内核</strong>：Shadowsocks (AEAD 对称加密)</div>
          <div>🛡️ <strong>线路要求</strong>：建议运行在 IEPL / IPLC 专线内网，CPU 占用极低</div>
          <div>🎯 <strong>适用场景</strong>：低延迟游戏加速与全设备通用</div>
        `;
      } else if (text.startsWith('vmess://')) {
        formatBadge.textContent = 'VMess 传统协议';
        formatBadge.className = 'badge-muted text-[10px]';
        detailsBox.innerHTML = `
          <div>⚡ <strong>协议内核</strong>：VMess (V2Ray 经典协议)</div>
          <div>🛡️ <strong>协议特征</strong>：加密开销适中，兼容老旧客户端</div>
          <div>🎯 <strong>适用场景</strong>：基础日常浏览</div>
        `;
      } else {
        formatBadge.textContent = '未知格式或 Base64 编码';
        formatBadge.className = 'badge-muted text-[10px]';
        detailsBox.innerHTML = `
          <div>⚠️ <strong>解析提示</strong>：文本未直接匹配标准协议前缀，可能是包含多个节点的 Base64 密文或配置文件片段。</div>
          <div>💡 <strong>建议</strong>：可使用订阅转换工具将其转换为 Clash 标准 YAML 配置。</div>
        `;
      }
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        nodeInput.value = '';
        resultBox.classList.add('hidden');
      });
    }
  }

  // Tool 2: Simulator logic
  const ispSelect = document.getElementById('sim-isp') as HTMLSelectElement;
  const destSelect = document.getElementById('sim-dest') as HTMLSelectElement;
  const lineSelect = document.getElementById('sim-line') as HTMLSelectElement;
  const pingOutput = document.getElementById('calc-ping');
  const adviceOutput = document.getElementById('calc-advice');
  const recLink = document.getElementById('calc-recommend-link') as HTMLAnchorElement;

  const latencyTable: Record<string, Record<string, { iepl: string; bgp: string; direct: string }>> = {
    hk: {
      telecom: { iepl: '15-28', bgp: '35-55', direct: '65-120' },
      unicom: { iepl: '20-35', bgp: '38-60', direct: '70-130' },
      mobile: { iepl: '18-32', bgp: '32-50', direct: '60-110' },
      cbn: { iepl: '25-45', bgp: '45-75', direct: '90-180' },
    },
    jp: {
      telecom: { iepl: '32-48', bgp: '55-85', direct: '110-220' },
      unicom: { iepl: '28-42', bgp: '48-75', direct: '95-180' },
      mobile: { iepl: '35-52', bgp: '58-90', direct: '120-240' },
      cbn: { iepl: '40-65', bgp: '70-110', direct: '150-280' },
    },
    sg: {
      telecom: { iepl: '38-55', bgp: '60-95', direct: '130-240' },
      unicom: { iepl: '45-65', bgp: '70-105', direct: '140-260' },
      mobile: { iepl: '35-50', bgp: '55-85', direct: '110-210' },
      cbn: { iepl: '50-75', bgp: '80-130', direct: '160-300' },
    },
    tw: {
      telecom: { iepl: '25-38', bgp: '45-70', direct: '90-160' },
      unicom: { iepl: '30-45', bgp: '50-80', direct: '100-180' },
      mobile: { iepl: '28-42', bgp: '48-75', direct: '95-170' },
      cbn: { iepl: '35-55', bgp: '60-95', direct: '120-220' },
    },
    us: {
      telecom: { iepl: '120-145', bgp: '145-180', direct: '220-350' },
      unicom: { iepl: '125-150', bgp: '150-190', direct: '230-360' },
      mobile: { iepl: '130-155', bgp: '160-205', direct: '250-380' },
      cbn: { iepl: '140-170', bgp: '180-230', direct: '280-420' },
    },
    uk: {
      telecom: { iepl: '135-165', bgp: '165-210', direct: '260-390' },
      unicom: { iepl: '130-160', bgp: '160-200', direct: '250-380' },
      mobile: { iepl: '145-175', bgp: '180-230', direct: '280-420' },
      cbn: { iepl: '160-200', bgp: '200-260', direct: '300-450' },
    },
  };

  function updateLatency() {
    if (!ispSelect || !destSelect || !lineSelect || !pingOutput || !adviceOutput) return;

    const isp = ispSelect.value;
    const dest = destSelect.value;
    const line = lineSelect.value as 'iepl' | 'bgp' | 'direct';

    const range = latencyTable[dest]?.[isp]?.[line] || '40-60';
    pingOutput.textContent = range;

    if (line === 'iepl') {
      adviceOutput.textContent = '👑 企业级内网海底光缆直通，晚高峰 0 丢包，支持 4K 影音与外服竞技联机。';
      if (recLink) recLink.href = '/recommend/';
    } else if (line === 'bgp') {
      adviceOutput.textContent = '⚡ 国内优质 BGP 机房中转，闲时速度优良，晚高峰存在轻微波动。';
      if (recLink) recLink.href = '/choose/budget/';
    } else {
      adviceOutput.textContent = '🌐 普通公网直连出海，晚高峰丢包预计 15%-30%，建议升级为专线服务。';
      if (recLink) recLink.href = '/choose/stable/';
    }
  }

  if (ispSelect && destSelect && lineSelect) {
    ispSelect.addEventListener('change', updateLatency);
    destSelect.addEventListener('change', updateLatency);
    lineSelect.addEventListener('change', updateLatency);
    updateLatency();
  }

  // Tool 3 & 4: Universal Copy Buttons with In-Place Visual Confirmation
  document.querySelectorAll('.copy-free-node-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const originalHtml = button.innerHTML;
      const code = button.getAttribute('data-promo-code') || '';

      if (code) {
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(code).catch(() => {});
        } else {
          const ta = document.createElement('textarea');
          ta.value = code;
          ta.style.position = 'fixed';
          ta.style.left = '-999999px';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          ta.remove();
        }
      }

      button.innerHTML = '<span>✅ 已复制！</span>';
      button.classList.add('bg-brand-mint', 'text-bg-main', 'font-bold');

      setTimeout(() => {
        button.innerHTML = originalHtml;
        button.classList.remove('bg-brand-mint', 'text-bg-main', 'font-bold');
      }, 2500);
    });
  });
</script>
