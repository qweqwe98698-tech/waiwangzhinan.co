        ))}
      </div>

      <!-- Robust Zero-Failure Bypass Solutions & DIY Guide -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl bg-bg-sub/80 border border-brand-mint/20 space-y-2 text-xs">
          <div class="flex items-center justify-between">
            <strong class="text-content-primary flex items-center gap-1.5">
