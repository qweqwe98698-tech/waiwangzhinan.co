---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const faq = [
  {
    question: "什么是订阅转换？什么时候需要用到它？",
    answer: "不同客户端支持的配置格式不同（例如 Clash 使用 YAML 格式，小火箭使用 Shadowrocket 专有格式，Sing-box 使用 JSON 格式）。如果你的机场只提供了一种通用链接或节点明文代码（如 vmess://、ss://），就需要通过订阅转换工具将其转换成对应客户端可以直接读取的订阅文件。"
  },
  {
    question: "使用第三方的公开订阅转换网站安全吗？",
    answer: "存在一定的隐私泄露风险。部分不可信的免费公共转换后端可能会在服务器日志中偷偷留存你的订阅 Token 并恶意盗刷。建议优先使用正规机场官方后台自带的「一键导入/转换」功能，或使用开源自建的 Subconverter 后端。"
  },
  {
    question: "订阅转换后提示「下载配置失败 / YAML 解析错误」怎么办？",
    answer: "通常是因为原始链接中包含特殊字符未转义，或者选择的规则模板（Remote Config）地址已失效。在转换工具中尝试切换「远程配置」为基础规则（如 ACL4SSR 基础版），或者去掉链接中多余的空格重新转换即可。"
  }
];

const nextSteps = [
