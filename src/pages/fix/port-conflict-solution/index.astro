---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const faq = [
  {
    question: "为什么 Clash Verge 会提示「Port 7890 already in use」？",
    answer: "通常是因为你此前安装过其他代理软件（如旧版 Clash for Windows、v2rayN、或者启动了后台运行的 Docker/安全软件），它们占用了默认的 7890 端口；或者是 Clash 崩溃后未正常释放端口。解决方法：在任务管理器中强制结束旧进程，或者在 Clash Verge 设置中将混合端口改为 `7897` 或 `17890` 等任意未占用端口。"
  },
  {
    question: "Windows 提示「无法设置系统代理 / WinHTTP 权限受限」怎么办？",
    answer: "很多国内杀毒软件（如 360 安全卫士、火绒或联想安全管家）会拦截修改系统代理注册表的行为。只需将 Clash Verge 加入安全软件的「信任区/白名单」，并以管理员身份重新运行客户端即可。"
  },
  {
    question: "端口改了之后，Chrome 浏览器怎么识别新端口？",
    answer: "Clash Verge 会在开启「系统代理」时自动将 Windows 系统的代理端口同步为修改后的端口（如 7897），Chrome 等基于系统代理的浏览器会自动同步识别，无需手动在浏览器里单独设置。"
  }
];

const nextSteps = [
