---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyMap from '../components/JourneyMap.astro';
import QuestionCloud from '../components/QuestionCloud.astro';
import DevicePicker from '../components/DevicePicker.astro';
import ScenarioPicker from '../components/ScenarioPicker.astro';
import SymptomPicker from '../components/SymptomPicker.astro';
import AirportMatcher from '../components/AirportMatcher.astro';
import { getCollection } from 'astro:content';

const allProviders = await getCollection('providers');

const statusCards = [
  {
    tag: '完全不懂',
    title: '我第一次想访问国外网站',
    desc: '不知道从哪下手，不知道 Google、ChatGPT 为什么打不开',
    url: '/start/',
    badge: 'L0 入门',
  },
  {
    tag: '刚听说机场',
    title: '别人说需要机场，但机场到底是什么？',
    desc: '搞不懂机场、节点、代理、VPN 到底有什么区别',
    url: '/airport/what-is-airport/',
    badge: 'L2 概念',
  },
  {
    tag: '已经有订阅',
    title: '我已经拿到了订阅链接，但不知道怎么用',
    desc: '三步教你把一串订阅链接导入电脑或手机客户端',
    url: '/airport/how-to-use/',
    badge: 'L3 使用',
  },
  {
    tag: '不知道装什么软件',
    title: '我的手机或电脑应该下载哪个客户端？',
    desc: '按 Windows / Mac / iPhone / 安卓选择最适合的工具',
    url: '/clients/',
    badge: 'L3 工具',
  },
  {
    tag: '准备选择服务',
    title: '我想找适合自己需求的服务商',
    desc: '按 AI、查资料、看视频或多设备，客观透明选型',
    url: '/choose/',
    badge: 'L4 选择',
  },
  {
    tag: '遇到连接问题',
    title: '节点全部超时、连不上、无法上网怎么办？',
    desc: '系统化排查清单，教你逐步定位网络故障原因',
    url: '/fix/',
    badge: 'L5 排错',
  },
];

const learningLevels = [
  { level: 'Level 0', name: '海外网站受限原因', url: '/start/how-to-access-overseas-websites/', desc: '为什么打不开？跨国解析与阻断机制' },
  { level: 'Level 1', name: '代理与 VPN 基础', url: '/start/what-is-proxy/', desc: '跑腿代购原理与智能规则分流' },
  { level: 'Level 2', name: '节点与线路类型', url: '/airport/what-is-node/', desc: '香港/日本/美国节点、专线与倍率' },
  { level: 'Level 3', name: '机场与订阅机制', url: '/airport/what-is-airport/', desc: '服务商平台与一键订阅配置' },
  { level: 'Level 4', name: '多平台客户端实战', url: '/clients/', desc: 'Clash Verge、小火箭、v2rayN 安装' },
  { level: 'Level 5', name: '需求选型与避坑', url: '/choose/', desc: '按需月付、IP 纯净度与流媒体解锁' },
  { level: 'Level 6', name: '常见故障与排错', url: '/fix/', desc: '超时、系统时间同步与端口冲突修复' },
];

const hotTutorials = [
  { title: '第一次访问海外网站完整指南', url: '/start/how-to-access-overseas-websites/', tag: 'L0 入门', desc: '搞清为什么打不开以及安全起步基本链路' },
  { title: 'Windows 电脑怎么使用机场（Clash Verge）', url: '/clients/windows/', tag: '客户端', desc: '下载安装、订阅导入与系统代理完整配置' },
  { title: 'iPhone (iOS) 怎么下载并使用小火箭', url: '/clients/iphone/', tag: '客户端', desc: '美区 Apple ID 获取与订阅扫码导入步骤' },
  { title: 'ChatGPT 国内怎么使用与防封指南', url: '/use/chatgpt/', tag: 'AI 场景', desc: '原生节点选择、无痕模式与 Access Denied 解决' },
  { title: '机场连不上全部超时怎么办？六步排查', url: '/fix/cannot-connect/', tag: '排错', desc: '系统时间校准、订阅更新与代理冲突修复' },
  { title: '新手友好型机场选型要点', url: '/choose/beginner/', tag: '选型', desc: '月付试错、一键导入与客服响应深度考量' },
];

const chooseCategories = [
  { title: '新手友好优先', url: '/choose/beginner/', desc: '提供傻瓜式一键导入、全平台图文教程、支持按月订购试错。' },
  { title: '高性价比优先', url: '/choose/budget/', desc: '月付 15-25 元区间，亚太主流节点覆盖，满足日常查资料。' },
  { title: 'AI 深度使用', url: '/choose/ai/', desc: '美国/新加坡原生住宅 IP，专职维护 ChatGPT/Claude 解锁。' },
  { title: '海外影音流媒体', url: '/choose/streaming/', desc: '大带宽内网专线，全面解锁 Netflix/Disney+/YouTube 4K。' },
  { title: '多设备家庭/办公', url: '/choose/multi-device/', desc: '支持 5 台以上设备同时在线，不限制公网 IP 数量。' },
  { title: '稳定优先专线', url: '/choose/stable/', desc: '全 IPLC/IEPL 企业内网专线，晚高峰 0 丢包与毫秒级响应。' },
];

const homepageFaq = [
  {
    question: "外网指南是一个机场推荐博客吗？",
    answer: "不是。外网指南是一个专门面向国内第一次产生海外网络访问需求的新手用户的交互式知识导航系统。我们不搞虚假排名或夸大营销，而是从最底层的原理、工具使用、排错方法到客观选型建立完整知识树。"
  },
  {
    question: "我完全没有技术背景，能看懂这个网站的内容吗？",
    answer: "完全可以。全站所有文章均采用大白话叙述，每篇文章开头均提供 30 秒极速解答，结尾均带有清晰的下一步行动指引，杜绝晦涩代码堆砌。"
  },
  {
    question: "按照网站指南操作会影响国内软件（如微信、网银）吗？",
    answer: "不会。现代代理工具标配「智能分流（规则模式）」，国内网站和应用默认走本地直连，完全不影响国内 App 的速度与正常登录。"
  }
];
---

<BaseLayout
  title="外网指南 - 第一次访问海外网站，从这里开始"
  description="面向国内第一次接触代理、节点、机场与客户端的新手用户，提供客观、循序渐进的交互式知识导航与排错中枢。"
  ogType="website"
  faq={homepageFaq}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-20">
    
    <!-- 1. HERO SECTION -->
    <section class="relative pt-6 pb-12 text-center md:text-left grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-mint/10 border border-brand-mint/20 text-xs font-semibold text-brand-mint">
          <span class="w-2 h-2 rounded-full bg-brand-mint animate-pulse"></span>
          <span>面向国内小白的新手知识导航系统</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-content-primary tracking-tight leading-[1.1]">
          第一次上外网？<br />
          <span class="text-brand-mint">从这里开始。</span>
        </h1>

        <p class="text-base sm:text-lg text-content-secondary max-w-2xl leading-relaxed">
          看不懂代理、节点、机场、Clash、小火箭和 v2rayN？这里会按顺序告诉你它们是什么、怎么用、怎么排错，以及下一步应该做什么。
        </p>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
          <a href="/start/" class="btn-primary text-sm !py-3 !px-6 shadow-glow-mint">
            <span>从零开始学习 (L0)</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>

          <a href="/recommend/" class="btn-secondary text-sm !py-3 !px-6 !border-brand-mint/40 text-brand-mint hover:bg-brand-mint/10 flex items-center gap-2">
            <span>🔥 2026 优质机场推荐与实测</span>
            <span class="text-xs">→</span>
          </a>
        </div>
      </div>

      <!-- Hero Interactive Path Preview -->
      <div class="lg:col-span-5">
        <div class="card-surface p-6 relative overflow-hidden border-brand-mint/20 shadow-2xl">
          <div class="flex items-center justify-between pb-3 border-b border-white/5 mb-4">
            <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Workflow 核心链路</span>
            <span class="text-[11px] text-content-muted font-mono">点击直接进入对应环节 ↗</span>
          </div>

          <div class="space-y-2.5 text-xs">
            <!-- Step 1 -->
            <a
              href="/start/scientific-surfing-guide/"
              class="flex items-center justify-between p-3 rounded-xl bg-bg-sub border border-brand-mint/30 hover:border-brand-mint hover:bg-brand-mint/[0.04] transition-all group shadow-sm hover:translate-x-1"
            >
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-mint text-bg-main font-bold flex items-center justify-center text-xs font-mono shadow-sm group-hover:scale-110 transition-transform">1</span>
                <div>
                  <span class="font-bold text-content-primary group-hover:text-brand-mint transition-colors">搜索问题</span>
                  <span class="text-content-secondary block text-[11px] mt-0.5">（如 Google / ChatGPT 为什么打不开）</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-brand-mint transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- Step 2 -->
            <a
              href="/start/what-is-proxy/"
              class="flex items-center justify-between p-3 rounded-xl bg-bg-sub/80 border border-white/5 hover:border-brand-mint/40 hover:bg-bg-sub transition-all group hover:translate-x-1"
            >
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-white/10 text-content-primary font-bold flex items-center justify-center text-xs font-mono group-hover:bg-brand-mint group-hover:text-bg-main transition-colors">2</span>
                <div>
                  <span class="font-bold text-content-primary group-hover:text-brand-mint transition-colors">30 秒直达答案</span>
                  <span class="text-content-secondary block text-[11px] mt-0.5">（搞懂代理跑腿与专线中转原理）</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-content-muted group-hover:text-brand-mint transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- Step 3 -->
            <a
              href="/clients/"
              class="flex items-center justify-between p-3 rounded-xl bg-bg-sub/80 border border-white/5 hover:border-brand-mint/40 hover:bg-bg-sub transition-all group hover:translate-x-1"
            >
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-white/10 text-content-primary font-bold flex items-center justify-center text-xs font-mono group-hover:bg-brand-mint group-hover:text-bg-main transition-colors">3</span>
                <div>
                  <span class="font-bold text-content-primary group-hover:text-brand-mint transition-colors">客户端配置实战</span>
                  <span class="text-content-secondary block text-[11px] mt-0.5">（按 Windows / Mac / 手机下载 Clash/小火箭）</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-content-muted group-hover:text-brand-mint transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>

            <!-- Step 4 -->
            <a
              href="/recommend/"
              class="flex items-center justify-between p-3 rounded-xl bg-bg-sub/80 border border-white/5 hover:border-brand-mint/40 hover:bg-bg-sub transition-all group hover:translate-x-1"
            >
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-white/10 text-content-primary font-bold flex items-center justify-center text-xs font-mono group-hover:bg-brand-mint group-hover:text-bg-main transition-colors">4</span>
                <div>
                  <span class="font-bold text-content-primary group-hover:text-brand-mint transition-colors">按需理性选型</span>
                  <span class="text-content-secondary block text-[11px] mt-0.5">（查看 2026 已核验推荐服务商并开通）</span>
                </div>
              </div>
              <svg class="w-4 h-4 text-content-muted group-hover:text-brand-mint transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 1.5. FEATURED AIRPORT SHOWCASE (DIRECT PROMOTION SECTION) -->
    <section class="card-surface p-6 sm:p-8 rounded-2xl border border-brand-mint/20 space-y-6 bg-gradient-to-b from-brand-mint/[0.03] to-transparent">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 pb-4 border-b border-white/10">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-mint mb-1">
            <span class="w-2 h-2 rounded-full bg-brand-mint animate-pulse"></span>
            <span>2026 Verified Navigation</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-content-primary tracking-tight">
            2026 编辑部实测核验 · 优质机场精选开通
          </h2>
        </div>
        <div class="flex items-center gap-3 text-xs">
          <a href="/recommend/" class="text-brand-mint hover:underline font-semibold flex items-center gap-1">
            <span>查看全部 16 家测速榜单</span>
            <span>→</span>
          </a>
          <span class="text-white/20">|</span>
          <a href="/compare/" class="text-content-secondary hover:text-content-primary">
            横向参数对比表
          </a>
        </div>
      </div>

      <!-- 8 Top Provider Cards with Primary Promoted Focus -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {(() => {
          const prioritySlugs = ['guangsu', 'xingdaomeng', 'feimao', 'u1s1', 'lingmao', 'sujie', 'yifanyun', 'yuzhou'];
          const sortedFeatured = prioritySlugs
            .map(s => allProviders.find(p => p.data.slug === s))
            .filter(Boolean);

          return sortedFeatured.map((p) => {
            const isTop1 = p.data.slug === 'guangsu';
            return (
              <div class={`card-surface-sub p-4 rounded-xl border transition-all flex flex-col justify-between space-y-3 relative ${
                isTop1 
                  ? 'border-brand-mint/50 bg-brand-mint/[0.04] ring-1 ring-brand-mint/20 shadow-lg shadow-brand-mint/10' 
                  : 'border-white/10 hover:border-brand-mint/30 bg-bg-card/90'
              }`}>
                {isTop1 && (
                  <div class="absolute -top-2.5 right-3 px-2 py-0.5 rounded bg-brand-mint text-bg-main text-[9px] font-black uppercase tracking-wider shadow-sm">
                    👑 综合第一主推
                  </div>
                )}

                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-1.5">
                      <h3 class="font-bold text-sm text-content-primary">
                        <a href={`/brands/${p.data.slug}/`} class="hover:text-brand-mint transition-colors">
                          {p.data.name}
                        </a>
                      </h3>
                      <span class="badge-mint text-[9px] !px-1.5 !py-0">{p.data.verificationStatus.includes('已核验') ? '已核验' : '实测'}</span>
                    </div>
                    <span class="font-mono text-xs font-bold text-brand-mint">
                      ¥{p.data.pricing.startingPrice}<span class="text-[10px] text-content-muted font-normal">/{p.data.pricing.billingCycle.includes('月') ? '月' : '起'}</span>
                    </span>
                  </div>

                  <p class="text-[11px] text-content-secondary line-clamp-2 leading-relaxed">
                    {p.data.tagline}
                  </p>

                  <div class="flex items-center justify-between text-[10px] font-mono text-content-muted pt-1">
                    <span>{p.data.pricing.traffic || '大流量'}</span>
                    <span>{p.data.protocols[0]}</span>
                  </div>

                  {p.data.promoCode && (
                    <div class="inline-block px-2 py-0.5 rounded bg-brand-mint/10 border border-brand-mint/20 text-[10px] font-mono text-brand-mint">
                      优惠码: <strong class="select-all font-bold">{p.data.promoCode}</strong>
                      {p.data.discount && <span class="text-[9px] text-content-muted ml-1 font-normal">({p.data.discount})</span>}
                    </div>
                  )}
                </div>

                <div class="pt-3 border-t border-white/5 flex items-center justify-between gap-2">
                  <a
                    href={`/brands/${p.data.slug}/`}
                    class="text-[11px] text-content-muted hover:text-content-primary transition-colors"
                  >
                    测速报告
                  </a>
                  {p.data.officialUrl && (
                    <a
                      href={p.data.officialUrl}
                      target="_blank"
                      rel="nofollow sponsored noopener"
                      class={`btn-primary text-[11px] !py-1.5 !px-3.5 font-bold shadow-md ${
                        isTop1 ? '!bg-brand-mint shadow-brand-mint/30' : ''
                      }`}
                    >
                      官网注册 ↗
                    </a>
                  )}
                </div>
              </div>
            );
          });
        })()}
      </div>
    </section>

    <!-- 2. JOURNEY MAP -->
    <section>
      <JourneyMap />
    </section>

    <!-- 3. SIX STATUS CARDS: 你现在是哪种情况？ -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Status Selector</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-content-primary tracking-tight mt-1">
            你现在是哪种情况？
          </h2>
        </div>
        <p class="text-xs text-content-secondary">
          选出最符合你当前遇到的状态，一键进入对应解决方案
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {statusCards.map((item) => (
          <a
            href={item.url}
            class="card-surface p-6 flex flex-col justify-between hover:border-brand-mint/40 transition-all duration-200 group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-semibold text-brand-mint">{item.tag}</span>
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 text-content-muted font-mono">{item.badge}</span>
              </div>
              <h3 class="font-bold text-base text-content-primary group-hover:text-brand-mint transition-colors mb-2">
                {item.title}
              </h3>
              <p class="text-xs text-content-secondary leading-relaxed">
                {item.desc}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-white/5 flex items-center justify-between text-xs text-brand-mint font-medium">
              <span>立即查看解决方案</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 4. LEVEL 0-6 LEARNING PATH -->
    <section class="card-surface p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Learning Ladder</span>
          <h2 class="text-2xl font-bold text-content-primary tracking-tight mt-1">
            Level 0–6 新手认知进阶路线
          </h2>
        </div>
        <p class="text-xs text-content-secondary">
          层层递进的内链知识骨架，避免碎片化学习
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3">
        {learningLevels.map((lvl, index) => (
          <a
            href={lvl.url}
            class="p-3.5 rounded-lg bg-bg-sub hover:bg-bg-hover border border-white/5 hover:border-brand-mint/30 transition-all flex flex-col justify-between group"
          >
            <div>
              <span class="text-[11px] font-mono font-bold text-brand-mint block mb-1">
                {lvl.level}
              </span>
              <h4 class="font-bold text-xs text-content-primary group-hover:text-brand-mint transition-colors mb-1">
                {lvl.name}
              </h4>
              <p class="text-[11px] text-content-muted leading-tight">
                {lvl.desc}
              </p>
            </div>
            <div class="pt-2 mt-2 border-t border-white/5 text-[10px] text-brand-mint/70 group-hover:text-brand-mint">
              进入 Pillar →
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 5. QUESTION CLOUD -->
    <section>
      <QuestionCloud />
    </section>

    <!-- 6. DEVICE PICKER -->
    <section>
      <DevicePicker />
    </section>

    <!-- 7. SCENARIO PICKER -->
    <section>
      <ScenarioPicker />
    </section>

    <!-- 7.5. SYMPTOM PICKER: 出现什么情况？ -->
    <section>
      <SymptomPicker />
    </section>

    <!-- 8. HIGH DEMAND TUTORIALS -->
    <section class="space-y-6">
      <div class="flex items-center justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Essential Guides</span>
          <h2 class="text-2xl font-bold text-content-primary tracking-tight mt-1">
            最近最常被问的高需求指南
          </h2>
        </div>
        <a href="/airport/" class="text-xs text-brand-mint hover:underline">查看全部知识库 →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {hotTutorials.map((tut) => (
          <a
            href={tut.url}
            class="card-surface p-5 rounded-xl flex flex-col justify-between hover:border-brand-mint/40 transition-all group"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10px] px-2 py-0.5 rounded bg-white/5 text-content-muted font-mono">{tut.tag}</span>
                <span class="text-[11px] text-brand-mint">30s 答案</span>
              </div>
              <h3 class="font-bold text-sm sm:text-base text-content-primary group-hover:text-brand-mint transition-colors mb-2">
                {tut.title}
              </h3>
              <p class="text-xs text-content-secondary leading-relaxed">
                {tut.desc}
              </p>
            </div>
            <div class="pt-3 mt-3 border-t border-white/5 text-xs text-brand-mint font-medium flex items-center justify-between">
              <span>阅读图文详解</span>
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 9. HOW TO CHOOSE CATEGORIES -->
    <section class="card-surface p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Category Breakdown</span>
          <h2 class="text-2xl font-bold text-content-primary tracking-tight mt-1">
            不知道怎么选？按真实使用需求分类
          </h2>
        </div>
        <p class="text-xs text-content-secondary">
          杜绝无脑推荐，先明确自己最核心的使用场景
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {chooseCategories.map((c) => (
          <a
            href={c.url}
            class="card-surface-sub p-4 rounded-xl border border-white/5 hover:border-brand-mint/30 transition-all group"
          >
            <h4 class="font-bold text-sm text-content-primary group-hover:text-brand-mint transition-colors mb-1.5">
              {c.title}
            </h4>
            <p class="text-xs text-content-secondary leading-relaxed mb-3">
              {c.desc}
            </p>
            <span class="text-xs text-brand-mint font-medium">查看选型指南 →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 10. AIRPORT MATCHER -->
    <section>
      <AirportMatcher />
    </section>

    <!-- 11. VERIFIED PROVIDERS REVIEWS (Objective Data, No Fake Claims) -->
    <section class="space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Verified Providers</span>
          <h2 class="text-2xl font-bold text-content-primary tracking-tight mt-1">
            已核验服务商档案（客观指标）
          </h2>
        </div>
        <a href="/compare/" class="text-xs text-brand-mint hover:underline">查看完整技术参数对比矩阵 →</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {allProviders.map((p) => (
          <div class="card-surface p-5 sm:p-6 rounded-xl flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="font-bold text-lg text-content-primary">{p.data.name}</h3>
                <span class="badge-mint text-[10px]">{p.data.verificationStatus}</span>
              </div>
              <p class="text-xs text-brand-mint font-medium mb-3">{p.data.tagline}</p>
              <p class="text-xs text-content-secondary leading-relaxed mb-4">{p.data.summary}</p>
              
              <div class="space-y-1.5 text-xs text-content-muted pt-3 border-t border-white/5">
                <div class="flex justify-between">
                  <span>起步价格：</span>
                  <span class="text-content-primary font-mono font-bold">¥{p.data.pricing.startingPrice} / {p.data.pricing.billingCycle}</span>
                </div>
                <div class="flex justify-between">
                  <span>AI / ChatGPT：</span>
                  <span class="text-content-primary">{p.data.aiSupport}</span>
                </div>
                <div class="flex justify-between">
                  <span>流媒体支持：</span>
                  <span class="text-content-primary">{p.data.streaming}</span>
                </div>
                <div class="flex justify-between text-[11px] text-content-muted">
                  <span>最后核验：</span>
                  <span class="font-mono">{p.data.lastVerified}</span>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-white/5 flex items-center gap-2">
              <a href={`/brands/${p.data.slug}/`} class="btn-secondary text-xs flex-1 text-center !py-2">
                查看客观档案
              </a>
              {p.data.officialUrl && (
                <a href={p.data.officialUrl} target="_blank" rel="nofollow sponsored noopener" class="btn-primary text-xs flex-1 text-center !py-2">
                  访问官网 ↗
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 12. FAQ SECTION -->
    <section class="card-surface p-6 sm:p-8 space-y-6">
      <div class="mb-4">
        <span class="text-xs font-bold text-brand-mint uppercase tracking-wider font-mono">Frequently Asked Questions</span>
        <h2 class="text-2xl font-bold text-content-primary tracking-tight mt-1">
          全站核心常见疑问
        </h2>
      </div>

      <div class="space-y-3">
        {homepageFaq.map((faq) => (
          <div class="card-surface-sub p-4 rounded-xl border border-white/5 space-y-1.5">
            <h3 class="font-bold text-sm text-content-primary flex items-start gap-2">
              <span class="text-brand-mint font-mono font-bold text-xs">Q:</span>
              <span>{faq.question}</span>
            </h3>
            <p class="text-xs text-content-secondary leading-relaxed pl-5">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- 13. FINAL CTA BANNER -->
    <section class="rounded-2xl bg-gradient-to-r from-bg-card via-bg-sub to-bg-card border border-brand-mint/30 p-8 sm:p-12 text-center space-y-4 shadow-glow-mint/10">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-content-primary">
        准备好开启第一次海外网络探索了吗？
      </h2>
      <p class="text-xs sm:text-sm text-content-secondary max-w-xl mx-auto leading-relaxed">
        不用担心复杂的网络术语。跟随清晰的认知路线，花 5 分钟搞定所有基础配置。
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a href="/start/" class="btn-primary text-sm !py-3 !px-8 shadow-glow-mint">
          <span>从零开始学习指南</span>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </a>
        <a href="/choose/" class="btn-secondary text-sm !py-3 !px-8">
          <span>直接进入选型对比</span>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
