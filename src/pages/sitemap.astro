---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allGuides = await getCollection('guides');
const allProviders = await getCollection('providers');

const categories = [
  { key: 'start', name: '从零开始', url: '/start/' },
  { key: 'airport', name: '机场入门', url: '/airport/' },
  { key: 'clients', name: '客户端教程', url: '/clients/' },
  { key: 'use', name: '使用场景', url: '/use/' },
  { key: 'fix', name: '故障排查', url: '/fix/' },
  { key: 'choose', name: '选型指南', url: '/choose/' },
];

const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '网站地图', url: '/sitemap/' },
];
---

<BaseLayout
  title="网站地图 (HTML Sitemap) - 外网指南"
  description="外网指南全站栏目、核心知识树、35+ 核心图文指南与服务商档案完整索引。"
  ogType="website"
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <header class="pb-6 border-b border-white/[0.08]">
      <span class="badge-mint mb-2">全站索引 · HTML Sitemap</span>
      <h1 class="text-3xl font-extrabold text-content-primary tracking-tight">
        网站地图
      </h1>
      <p class="text-sm text-content-secondary mt-2">
        全站所有栏目、核心指南与工具页面的完整层级索引。
      </p>
    </header>

    <!-- Main Navigation Hubs -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((cat) => {
        const catGuides = allGuides.filter((g) => g.data.category === cat.key).sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
        return (
          <div class="card-surface p-5 rounded-xl space-y-3">
            <h2 class="font-bold text-base text-content-primary pb-2 border-b border-white/5 flex items-center justify-between">
              <a href={cat.url} class="text-brand-mint hover:underline">
                {cat.name}
              </a>
              <span class="text-[10px] font-mono text-content-muted">({catGuides.length} 篇)</span>
            </h2>
            <ul class="space-y-2 text-xs">
              {catGuides.map((g) => {
                const slug = g.id.replace(new RegExp(`^${cat.key}/`), '').replace(/\.(md|mdx)$/, '');
                return (
                  <li>
                    <a
                      href={`/${cat.key}/${slug}/`}
                      class="text-content-secondary hover:text-brand-mint transition-colors block truncate"
                    >
                      • {g.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>

    <!-- Provider Brands & Compare -->
    <div class="card-surface p-6 rounded-xl space-y-4">
      <h2 class="font-bold text-base text-content-primary pb-2 border-b border-white/5">
        服务商客观档案与选型对比
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <a href="/recommend/" class="p-3 rounded-lg bg-bg-sub hover:bg-bg-hover text-brand-mint block">
          → 综合推荐中枢与匹配器
        </a>
        <a href="/compare/" class="p-3 rounded-lg bg-bg-sub hover:bg-bg-hover text-brand-mint block">
          → 服务商客观技术对比矩阵
        </a>
        {allProviders.map((p) => (
          <a href={`/brands/${p.data.slug}/`} class="p-3 rounded-lg bg-bg-sub hover:bg-bg-hover text-content-secondary hover:text-content-primary block">
            • {p.data.name} 档案
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
