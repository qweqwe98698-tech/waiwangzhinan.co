---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';

const faq = [
  {
    question: "用机场专线打外服游戏，能做到多少 ping 的延迟？",
    answer: "通常在沿海城市（如广东、上海、浙江）：连接香港 IEPL 专线打港服游戏（如 APEX/英雄联盟外服）延迟仅需 15-30ms；连接日本东京专线打日服延迟 35-50ms；连接新加坡专线延迟 45-60ms，几乎与国内本地服务器体验一致。"
  },
  {
    question: "下载几百 GB 的 Steam 游戏时怎么选节点最划算？",
    answer: "游戏下载不需要极低的联机延迟，但对带宽吞吐和流量消耗要求极高。建议在下载游戏时切换到机场的「0.2x 低倍率节点」或「大带宽下载专用节点」，这样 100GB 套餐可以下载 500GB 游戏，既跑满千兆宽带又省流量。"
  },
  {
    question: "打主机游戏（PS5 / Switch / Xbox）怎么通过电脑代理加速？",
    answer: "可以在电脑 Clash Verge 中开启「允许局域网连接 (Allow LAN)」，并在主机网络设置中手动将代理服务器 IP 设为电脑的局域网内网 IP（如 `192.168.1.100:7897`）；或者通过刷了 OpenWrt 路由器的软路由全屋透明代理。"
  }
];

const nextSteps = [
  {
    title: "学习开启 TUN 模式以无损转发游戏 UDP 数据",
    url: "/clients/tun-mode-guide/",
